# ==========================================================================
# PHP MVC ROUTING CONFIGURATION
# ==========================================================================

# 1. Enable the Rewrite Engine
RewriteEngine On

# 2. Set the Rewrite Base to your subdirectory
# IMPORTANT: This must match the folder name exactly!
RewriteBase /projects/php-mvc/

# 3. If the request is for an actual file (like CSS, JS, or images), serve it directly
RewriteCond %{REQUEST_FILENAME} !-f

# 4. If the request is for an actual directory, serve it directly
RewriteCond %{REQUEST_FILENAME} !-d

# 5. Route all other requests to index.php
# [QSA] = Query String Append (keeps ?id=1 etc. intact)
# [L] = Last rule (stop processing further rules)
RewriteRule ^(.*)$ index.php [QSA,L]

# ==========================================================================
# SECURITY & PERFORMANCE (Optional but Recommended)
# ==========================================================================

# Prevent directory browsing
Options -Indexes

# Protect sensitive files (like .env or config files if you add them later)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>